# Copy to .env and fill in to use real Jira data, or use the app's "Connect Jira" guide, which writes this file.
# With no .env, the app runs on built-in demo data.

# JIRA_BASE_URL=https://your-site.atlassian.net
# JIRA_EMAIL=you@example.com
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_API_TOKEN=
# JIRA_JQL=project = ABC AND sprint in openSprints()

# Needed for "+ New quest"
# JIRA_PROJECT_KEY=ABC
# JIRA_ISSUE_TYPE=Task

# Story points field id. Leave it out and JiraPlay finds it on your site.
# JIRA_POINTS_FIELD=customfield_10016

# Jira board whose columns to show (the number in the board URL). Empty uses the project's board.
# JIRA_BOARD_ID=

# Sprint field id (the sprint name is the big banner title). Leave it out and JiraPlay finds it on your site.
# JIRA_SPRINT_FIELD=customfield_10020

# The token is only sent to *.atlassian.net (and *.jira.com). For a Jira Cloud custom domain, list it here, comma-separated.
# JIRA_ALLOWED_HOSTS=jira.example.com
